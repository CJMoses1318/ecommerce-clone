# Copy to .env.local and fill in values. Required for the app to run with full features.

# Sanity (required for content and studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-06

# Sanity API token (optional; needed for creating/updating content e.g. customers)
SANITY_API_TOKEN=

# Clerk (required for auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (required for checkout and webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: base URL for links (defaults to localhost in dev)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
